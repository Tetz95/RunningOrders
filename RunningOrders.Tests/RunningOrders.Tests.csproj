<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests. The mod's classes are internal, so instead of referencing
    RunningOrders.csproj (whose build also installs the mod) this compiles the
    mod sources together with the tests into one test assembly.

    Run: dotnet test RunningOrders.Tests/RunningOrders.Tests.csproj (outside the game: the tests use plain test cars)
    The game install folder comes from Paths.user (RrInstallDir).
  -->
  <Import Project="..\Paths.user" Condition="Exists('..\Paths.user')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RunningOrders.Tests</AssemblyName>
    <RootNamespace>RunningOrders.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RrManagedDir>$(RrInstallDir)\Railroader_Data\Managed</RrManagedDir>
    <WqSource>..\RunningOrders</WqSource>
    <RR2026Ported>true</RR2026Ported>
  </PropertyGroup>

  <!-- The tests in this folder are included by default; add the mod sources (not their build folders) -->
  <ItemGroup>
    <Compile Include="$(WqSource)\**\*.cs" Exclude="$(WqSource)\obj\**;$(WqSource)\bin\**;$(WqSource)\obj-rr2026\**;$(WqSource)\bin-rr2026\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!-- The game's assemblies, copied next to the tests so they load. -->
  <ItemGroup>
    <GameReference Include="Railroader;Railroader.Modding;KeyValue.Runtime;Newtonsoft.Json;UnityEngine;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.InputModule;UnityEngine.JSONSerializeModule;UnityEngine.PhysicsModule;UnityEngine.UI;UnityEngine.UIModule;UnityEngine.ImageConversionModule;UnityEngine.InputLegacyModule;UnityEngine.TextRenderingModule;Unity.InputSystem;Unity.RenderPipelines.Universal.Runtime;Unity.TextMeshPro" />
    <Reference Include="@(GameReference)">
      <HintPath>$(RrManagedDir)\%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
